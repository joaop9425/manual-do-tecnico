{
  "$ref": "#/definitions/noticias",
  "definitions": {
    "noticias": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "pubDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "seguranca",
            "hardware",
            "atualizacoes-criticas"
          ]
        },
        "revision": {
          "type": "string",
          "default": "1.0"
        },
        "excerpt": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "source",
        "sourceUrl",
        "pubDate",
        "category"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}