---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const allNews = await getCollection("noticias");
    const categories = [...new Set(allNews.map((n) => n.data.category))];

    return categories.map((category) => ({
        params: { category },
        props: {
            category,
            news: allNews.filter((n) => n.data.category === category),
        },
    }));
}

const { category, news } = Astro.props;
const sortedNews = news.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`Notícias de ${category.charAt(0).toUpperCase() + category.slice(1)} :: Manual do Técnico`}>
    <!-- HERO SECTION -->
    <header class="mb-16 border-l-4 border-brand-500 pl-6 py-2">
        <nav class="flex items-center gap-2 text-[10px] font-bold text-surface-400 uppercase tracking-widest mb-4">
            <a href={`${base}`} class="hover:text-brand-500 transition-colors">Home</a>
            <span>/</span>
            <a href={`${base}noticias`} class="hover:text-brand-500 transition-colors">Notícias</a>
            <span>/</span>
            <span class="text-brand-500">{category}</span>
        </nav>
        <h1 class="text-4xl md:text-6xl font-bold text-surface-950 tracking-tight font-display mb-4">
            {category.charAt(0).toUpperCase() + category.slice(1)}
        </h1>
        <p class="text-lg text-surface-600 max-w-2xl leading-relaxed">
            Acompanhe as últimas atualizações, tendências e avisos importantes sobre <span class="font-semibold text-surface-900">{category}</span> compilados de diversas fontes confiáveis.
        </p>
    </header>

    <!-- NEWS GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
        {
            sortedNews.map((item) => (
                <article class="group relative flex flex-col bg-white rounded-2xl border border-surface-200 overflow-hidden hover:border-brand-200 hover:shadow-2xl hover:shadow-brand-500/5 transition-all duration-300">
                    <div class="p-8 flex flex-col h-full">
                        <!-- META -->
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <span class="text-[10px] font-black bg-brand-50 text-brand-600 px-2 py-1 rounded-md uppercase tracking-tighter">
                                    {item.data.source}
                                </span>
                                {item.data.revision && (
                                    <span class="text-[10px] font-medium text-surface-400 bg-surface-50 px-2 py-1 rounded-md border border-surface-100">
                                        ver. {item.data.revision}
                                    </span>
                                )}
                            </div>
                            <time datetime={item.data.pubDate.toISOString()} class="text-[10px] font-bold text-surface-400 uppercase tracking-widest">
                                {item.data.pubDate.toLocaleDateString("pt-BR", {
                                    day: '2-digit',
                                    month: 'short',
                                    year: 'numeric'
                                })}
                            </time>
                        </div>

                        <!-- CONTENT -->
                        <div class="flex-grow">
                            <h2 class="text-xl font-bold text-surface-950 group-hover:text-brand-600 transition-colors leading-tight mb-4 font-display">
                                <a href={`${base}noticias/${item.slug}`}>
                                    {item.data.title}
                                </a>
                            </h2>

                            <p class="text-sm text-surface-500 leading-relaxed line-clamp-4">
                                {item.data.excerpt || "Sem descrição disponível."}
                            </p>
                        </div>

                        <!-- ACTIONS -->
                        <div class="mt-8 pt-6 border-t border-surface-100 flex items-center justify-between">
                            <a
                                href={`${base}noticias/${item.slug}`}
                                class="inline-flex items-center gap-2 text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-wider"
                            >
                                Ler Local 
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                            </a>
                            <a
                                href={item.data.sourceUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-[10px] font-bold text-surface-300 hover:text-surface-500 transition-colors uppercase tracking-widest flex items-center gap-1"
                            >
                                Origem <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                            </a>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>

    {sortedNews.length === 0 && (
        <div class="py-20 text-center bg-surface-50 rounded-3xl border-2 border-dashed border-surface-200">
            <p class="text-surface-400 font-medium">Nenhuma notícia encontrada nesta categoria.</p>
            <a href={`${base}noticias`} class="mt-4 inline-block text-brand-500 font-bold hover:underline">Voltar para o Feed Geral</a>
        </div>
    )}
</BaseLayout>
