---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const allNews = await getCollection("noticias");
    return allNews.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={entry.data.title}>
    <article class="max-w-2xl mx-auto">
        <header class="mb-12">
            <div
                class="flex items-center gap-4 text-xs font-bold text-brand-600 uppercase tracking-widest mb-6"
            >
                <a href={`${base}noticias`} class="hover:underline">Notícias</a>
                <span>/</span>
                <span>{entry.data.source}</span>
            </div>
            <h1
                class="text-3xl md:text-4xl font-bold text-surface-950 tracking-tight leading-tight mb-6"
            >
                {entry.data.title}
            </h1>
            <div class="text-sm text-surface-400 font-medium">
                Publicado em {
                    entry.data.pubDate.toLocaleDateString("pt-BR", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                    })
                }
            </div>
        </header>

        <div
            class="prose prose-slate max-w-none
                prose-p:text-surface-600 prose-p:leading-relaxed
                prose-a:text-brand-500 prose-a:font-semibold"
        >
            {
                entry.data.excerpt && (
                    <div class="relative p-8 md:p-12 bg-white rounded-[2.5rem] border border-surface-200 shadow-premium overflow-hidden group">
                        <div class="absolute -top-12 -right-12 w-48 h-48 bg-brand-50/50 rounded-full group-hover:scale-110 transition-transform duration-700" />
                        <div class="relative z-10 flex flex-col items-center text-center">
                            <div class="w-12 h-1 bg-brand-500 rounded-full mb-8" />
                            <p class="text-xl md:text-2xl text-surface-800 font-medium leading-relaxed italic font-display">
                                "{entry.data.excerpt}"
                            </p>
                        </div>
                    </div>
                )
            }
            <div
                class="bg-surface-50 border border-surface-200 rounded-2xl p-6 md:p-8 mb-10"
            >
                <Content />
            </div>
        </div>

        <div class="mt-16 space-y-12">
            <div class="text-center pt-4">
                <a
                    href={entry.data.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-3 px-10 py-5 bg-surface-950 text-white font-bold rounded-2xl hover:bg-brand-600 hover:-translate-y-1 transition-all shadow-xl shadow-surface-950/20 group"
                >
                    <span>Ler Artigo Completo na Fonte</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </article>
</BaseLayout>
