---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const latestNews = (await getCollection("noticias"))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);

const featuredContent = (await getCollection("conteudos")).slice(0, 3);
---

<BaseLayout title="Manual do Técnico :: Home">
    <!-- HERO -->
    <section class="mb-24 text-center">
        <div
            class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-brand-600 uppercase bg-brand-50 rounded-full"
        >
            Base de Conhecimento v2.0
        </div>
        <h1
            class="text-5xl md:text-7xl font-bold text-surface-950 font-display mb-8 tracking-tight"
        >
            O guia definitivo para <span class="text-brand-500"
                >Técnicos de Hardware</span
            >.
        </h1>
        <p
            class="text-xl text-surface-600 max-w-2xl mx-auto mb-10 leading-relaxed"
        >
            Diagnósticos profundos, notícias filtradas e ferramentas essenciais
            para otimizar sua rotina técnica.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a
                href="/conteudos"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Explorar Conteúdos
            </a>
            <a
                href="/noticias"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Ver Notícias
            </a>
            <a
                href="/ferramentas"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Ferramentas
            </a>
        </div>
    </section>

    <!-- LATEST NEWS ROW -->
    <section class="mb-24">
        <div class="flex items-end justify-between mb-10">
            <div>
                <h2 class="text-3xl font-bold text-surface-950 tracking-tight">
                    Notícias Recentes
                </h2>
                <p class="text-surface-500 mt-2">
                    O que está acontecendo no mundo do hardware e segurança.
                </p>
            </div>
            <a
                href="/noticias"
                class="text-brand-500 font-semibold text-sm hover:underline"
                >Ver todas &rarr;</a
            >
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                latestNews.map((news) => (
                    <a
                        href={`/noticias/${news.slug}`}
                        class="block space-y-4"
                        target="_blank"
                    >
                        <div class="aspect-[16/9] bg-surface-200 rounded-2xl overflow-hidden relative border border-surface-100">
                            <div class="absolute inset-0 bg-gradient-to-t from-surface-950/20 to-transparent" />
                            <div class="absolute top-4 left-4 bg-white/90 backdrop-blur px-2 py-1 rounded-md text-[10px] font-bold uppercase tracking-widest text-surface-600">
                                {news.data.source}
                            </div>
                        </div>
                        <div class="space-y-2">
                            <h3 class="font-bold text-lg text-surface-950 leading-snug group-hover:text-brand-500 transition-colors">
                                {news.data.title}
                            </h3>
                            <p class="text-sm text-surface-500 line-clamp-2">
                                {news.data.excerpt}
                            </p>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- CONTENT GRID -->
    <section
        class="bg-white rounded-3xl p-10 md:p-16 border border-surface-200 shadow-clean"
    >
        <div class="mb-12">
            <h2 class="text-3xl font-bold text-surface-950 tracking-tight">
                Conteúdos em Destaque
            </h2>
            <p class="text-surface-500 mt-2">
                Guias técnicos detalhados para profissionais.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            {
                featuredContent.map((content) => (
                    <a
                        href={`/conteudos/${content.slug}`}
                        class="block space-y-4"
                        target="_blank"
                    >
                        <div class="flex-shrink-0 w-16 h-16 bg-brand-50 rounded-2xl flex items-center justify-center text-brand-500 group-hover:bg-brand-500 group-hover:text-white transition-all">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="w-8 h-8"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                />
                            </svg>
                        </div>
                        <div class="space-y-1">
                            <h3 class="font-bold text-xl text-surface-950 group-hover:text-brand-500 transition-colors">
                                {content.data.title}
                            </h3>
                            <p class="text-surface-500 leading-relaxed text-sm">
                                {content.data.description}
                            </p>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</BaseLayout>
