---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import { getCollection } from "astro:content";

const latestNews = (await getCollection("noticias"))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 5);

const featuredContent = (await getCollection("conteudos")).slice(0, 6);
---

<BaseLayout 
    title="Manual do Técnico :: Hub de Conhecimento e Notícias para Profissionais de TI"
    description="A maior base de conhecimento para técnicos de hardware e TI no Brasil. Encontre manuais, guias de reparo, notícias atualizadas e ferramentas essenciais para a sua bancada."
>
    <!-- HERO -->
    <section class="mb-24 text-center">
        <div
            class="inline-block px-4 py-1.5 mb-6 text-sm font-semibold tracking-wide text-brand-600 uppercase bg-brand-50 rounded-full"
        >
            Base de Conhecimento v2.0
        </div>
        <h1
            class="text-5xl md:text-7xl font-bold text-surface-950 font-display mb-8 tracking-tight"
        >
            O guia definitivo para <span class="text-brand-500"
                >Técnicos de Hardware</span
            >.
        </h1>
        <p
            class="text-xl text-surface-600 max-w-2xl mx-auto mb-10 leading-relaxed"
        >
            Diagnósticos profundos, notícias filtradas e ferramentas essenciais
            para otimizar sua rotina técnica.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
            <a
                href="/conteudos"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Explorar Conteúdos
            </a>
            <a
                href="/noticias"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Ver Notícias
            </a>
            <a
                href="/ferramentas"
                class="px-8 py-4 bg-white text-surface-950 border border-surface-200 font-semibold rounded-xl hover:bg-surface-50 transition-all"
            >
                Ferramentas
            </a>
        </div>
    </section>

    <!-- CONTENT + NEWS LAYOUT -->
    <section class="mb-24 overflow-hidden">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10">
            <div>
                <h2 class="text-3xl md:text-4xl font-bold text-surface-950 tracking-tight font-display">
                    Conteúdos e Notícias
                </h2>
                <p class="text-surface-500 mt-2 text-lg">
                    Guias técnicos profissionais e as últimas notícias do setor.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-4 text-xs font-bold uppercase tracking-widest">
                <a
                    href="/conteudos"
                    class="text-brand-600 hover:text-brand-700 transition-colors"
                    >Ver todos os conteúdos</a
                >
                <span class="text-surface-300">|</span>
                <a
                    href="/noticias"
                    class="text-surface-400 hover:text-brand-600 transition-colors"
                    >Ver notícias</a
                >
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-[7fr_3fr] gap-12">
            <!-- LEFT COLUMN: Featured Content (Main Focus - 70%) -->
            <div class="space-y-6">
                <div class="mb-4">
                    <h3 class="text-2xl font-bold text-surface-950 tracking-tight">
                        📚 Conteúdos em Destaque
                    </h3>
                    <p class="text-sm text-surface-500 mt-1">
                        Guias técnicos detalhados para profissionais
                    </p>
                </div>
                {
                    featuredContent.map((content) => (
                        <article class="group bg-white rounded-2xl overflow-hidden border border-surface-200 hover:border-brand-300 hover:shadow-lg transition-all">
                            {/* Image Section */}
                            <div class="aspect-[16/9] bg-gradient-to-br from-brand-50 to-surface-100 relative overflow-hidden">
                                {content.data.image ? (
                                    <img
                                        src={content.data.image}
                                        alt={content.data.title}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                    />
                                ) : (
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-20 h-20 text-brand-300"
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                            />
                                        </svg>
                                    </div>
                                )}
                                {/* Category Badge */}
                                <div class="absolute top-4 left-4 bg-brand-500 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
                                    {content.data.category}
                                </div>
                            </div>

                            {/* Content Section */}
                            <div class="p-6 space-y-4">
                                {/* Title */}
                                <h4 class="text-xl font-bold text-surface-950 group-hover:text-brand-500 transition-colors leading-tight">
                                    <a
                                        href={`/conteudos/${content.slug}`}
                                    >
                                        {content.data.title}
                                    </a>
                                </h4>

                                {/* Description */}
                                <p class="text-surface-600 leading-relaxed line-clamp-2">
                                    {content.data.description}
                                </p>

                                {/* Tags */}
                                {content.data.tags && content.data.tags.length > 0 && (
                                    <div class="flex flex-wrap gap-2">
                                        {content.data.tags.slice(0, 3).map((tag) => (
                                            <span class="text-xs bg-surface-100 text-surface-600 px-2 py-1 rounded">
                                                #{tag}
                                            </span>
                                        ))}
                                    </div>
                                )}

                                {/* Actions and Share */}
                                <div class="pt-2 flex items-center justify-between border-t border-surface-100">
                                    <a
                                        href={`/conteudos/${content.slug}`}
                                        class="text-sm font-bold text-brand-500 hover:text-brand-600 uppercase tracking-wider"
                                    >
                                        Ler Guia &rarr;
                                    </a>

                                    {/* Share Buttons */}
                                    <ShareButtons
                                        title={content.data.title}
                                        url={`${Astro.url.origin}/conteudos/${content.slug}`}
                                    />
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>

            <!-- RIGHT COLUMN: News Sidebar (Secondary - 30%) -->
            <aside class="space-y-4">
                <div class="mb-3">
                    <h3 class="text-xl font-bold text-surface-950 tracking-tight">
                        📰 Últimas Notícias
                    </h3>
                    <p class="text-xs text-surface-500 mt-1">
                        Novidades do setor via RSS
                    </p>
                </div>
                {
                    latestNews.map((news) => (
                        <article class="group bg-white rounded-xl p-4 border border-surface-200 hover:border-brand-300 hover:shadow-md transition-all">
                            <div class="space-y-3">
                                <!-- Meta Info -->
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="text-[9px] font-bold bg-surface-100 text-surface-500 px-1.5 py-0.5 rounded tracking-widest uppercase">
                                        {news.data.source}
                                    </span>
                                    <span class="text-[9px] font-bold text-brand-600 uppercase tracking-widest">
                                        {news.data.category}
                                    </span>
                                    <span class="text-[9px] text-surface-400">
                                        {news.data.pubDate.toLocaleDateString(
                                            "pt-BR",
                                            {
                                                day: "2-digit",
                                                month: "short",
                                            },
                                        )}
                                    </span>
                                </div>

                                <!-- Title -->
                                <h4 class="text-sm font-bold text-surface-950 group-hover:text-brand-500 transition-colors leading-tight">
                                    <a
                                        href={`/noticias/${news.slug}`}
                                        target="_blank"
                                    >
                                        {news.data.title}
                                    </a>
                                </h4>

                                {/* Excerpt/Summary from RSS */}
                                {news.data.excerpt && (
                                    <p class="text-xs text-surface-600 leading-relaxed line-clamp-3">
                                        {news.data.excerpt}
                                    </p>
                                )}

                                <!-- Actions -->
                                <div class="pt-2 flex items-center justify-between border-t border-surface-100">
                                    <div class="flex items-center gap-3">
                                        <a
                                            href={`/noticias/${news.slug}`}
                                            class="text-[10px] font-bold text-surface-600 hover:text-brand-500 transition-all uppercase tracking-wider"
                                        >
                                            Ler no Site
                                        </a>
                                        <span class="text-surface-300">•</span>
                                        <a
                                            href={news.data.sourceUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="text-[10px] font-bold text-surface-400 hover:text-brand-500 transition-all uppercase tracking-wider"
                                        >
                                            Fonte &nearr;
                                        </a>
                                    </div>

                                    <!-- Share Buttons (Compact) -->
                                    <div class="flex items-center gap-1.5">
                                        <a
                                            href={`https://wa.me/?text=${encodeURIComponent(news.data.title + ' - ' + Astro.url.origin + '/noticias/' + news.slug)}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Compartilhar no WhatsApp"
                                            class="w-6 h-6 flex items-center justify-center rounded-full bg-surface-100 hover:bg-[#25D366] text-surface-600 hover:text-white transition-all"
                                        >
                                            <svg
                                                class="w-3 h-3"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                                            </svg>
                                        </a>
                                        <a
                                            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(news.data.title)}&url=${encodeURIComponent(Astro.url.origin + '/noticias/' + news.slug)}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Compartilhar no X"
                                            class="w-6 h-6 flex items-center justify-center rounded-full bg-surface-100 hover:bg-black text-surface-600 hover:text-white transition-all"
                                        >
                                            <svg
                                                class="w-3 h-3"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </aside>
        </div>
    </section>

</BaseLayout>
