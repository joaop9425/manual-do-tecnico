---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allContent = await getCollection("conteudos");
const categories = [...new Set(allContent.map((post) => post.data.category))];
---

<BaseLayout title="Conteúdos :: Guia do Técnico">
  <div class="mb-16">
    <h1 class="text-4xl md:text-5xl font-bold text-surface-950 tracking-tight mb-4">Manual de Protocolos</h1>
    <p class="text-surface-600 text-lg max-w-2xl leading-relaxed">
      Nossos guias técnicos passo-a-passo para reparo, otimização e diagnóstico de sistemas.
    </p>
  </div>

  <!-- CATEGORY FILTER -->
  <div class="flex flex-wrap gap-4 mb-16 pb-8 border-b border-surface-200">
    <a href="/conteudos" class="px-5 py-2.5 rounded-full text-sm font-semibold bg-surface-950 text-white shadow-clean">
      Ver Todos
    </a>
    {categories.map(cat => (
      <a href={`/conteudos/${cat}`} class="px-5 py-2.5 rounded-full text-sm font-semibold border border-surface-200 text-surface-600 hover:bg-surface-50 hover:text-surface-950 transition-all">
        {cat.charAt(0).toUpperCase() + cat.slice(1)}
      </a>
    ))}
  </div>

  <!-- CONTENT GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
    {allContent.map((content) => (
      <article class="group relative">
        <a href={`/conteudos/${content.slug}`} class="block space-y-4" target="_blank">
          <div class="aspect-[16/9] bg-surface-100 rounded-2xl overflow-hidden mb-6 border border-surface-200 group-hover:shadow-premium transition-all duration-300">
             <!-- Placeholder visual ou Gradiente sutil -->
             <div class="w-full h-full bg-gradient-to-br from-brand-100 to-transparent flex items-center justify-center">
                <span class="text-xs font-bold uppercase tracking-widest text-brand-600 opacity-40">DOCS: {content.data.category}</span>
             </div>
          </div>
          <div class="space-y-3">
            <div class="text-xs font-bold text-brand-600 uppercase tracking-widest">{content.data.category}</div>
            <h2 class="text-2xl font-bold text-surface-950 group-hover:text-brand-500 transition-colors leading-snug">
              {content.data.title}
            </h2>
            <p class="text-surface-500 leading-relaxed line-clamp-2">
              {content.data.description}
            </p>
            <div class="flex items-center gap-4 pt-2 text-xs font-medium text-surface-400">
               <span>Por {content.data.author}</span>
               <span>•</span>
               <span>{content.data.publishDate.toLocaleDateString()}</span>
            </div>
          </div>
        </a>
      </article>
    ))}
  </div>
</BaseLayout>
