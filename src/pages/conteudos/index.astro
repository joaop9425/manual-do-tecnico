---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentExplorer from "../../components/react/ContentExplorer";

const allContent = await getCollection("conteudos");
const categories = [...new Set(allContent.map((c) => c.data.category))].sort();
const sortedContent = allContent.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Manuais, Guias e Documentação Técnica :: Manual do Técnico"
  description="Explore nossa biblioteca completa de manuais técnicos, guias de manutenção preventiva e documentações detalhadas para hardware e infraestrutura. Tudo procedimentado para o seu dia a dia."
>
  <header class="mb-12">
    <h1
      class="text-4xl md:text-6xl font-bold text-surface-950 tracking-tight font-display mb-6"
    >
      Conhecimento Técnico
    </h1>
    <p class="text-lg text-surface-600 max-w-2xl leading-relaxed">
      Nossa biblioteca de manuais, guias e documentações técnicas procedurais
      para o dia a dia do técnico.
    </p>
  </header>

  <ContentExplorer
    client:load
    initialContent={sortedContent}
    availableCategories={categories}
    base={base}
  />
</BaseLayout>
