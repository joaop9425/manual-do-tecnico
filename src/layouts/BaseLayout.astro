---
import { getCollection } from "astro:content";
import CookieConsent from "../components/react/CookieConsent";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalURL?: string;
    googleAnalyticsId?: string;
}

const {
    title = "Manual do Técnico :: Hub de Conhecimento e Notícias para Profissionais de TI",
    description = "A maior base de conhecimento para técnicos de hardware e TI no Brasil. Encontre manuais, guias de reparo, notícias atualizadas e ferramentas essenciais para a sua bancada.",
    image = "/og-image.png",
    canonicalURL = new URL(
        Astro.url.pathname,
        Astro.site || "https://manualdotecnico.com.br",
    ).href,
    googleAnalyticsId = "G-HPQ56VY5Y1" // Adicione seu ID aqui futuramente (ex: G-XXXXXXXXXX)
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="pt-BR" class="scrollbar-gutter-stable">
    <head>
        <!-- Google Analytics (GA4) -->
        {googleAnalyticsId && (
            <>
                <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
                <script is:inline define:vars={{ googleAnalyticsId }}>
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', googleAnalyticsId);
                </script>
            </>
        )}
        <!-- Global Metadata -->
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" sizes="any" />
        <link rel="shortcut icon" href={`${base}favicon.svg`} type="image/svg+xml" />
        <meta name="generator" content={Astro.generator} />
        <meta name="theme-color" content="#2563eb" />
        <link rel="manifest" href={`${base}site.webmanifest`} />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonicalURL} />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.url)} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={new URL(image, Astro.url)} />

        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@400;600;700;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            .scrollbar-gutter-stable {
                scrollbar-gutter: stable;
            }
            html,
            body {
                max-width: 100%;
                overflow-x: clip; /* Alternative to hidden that handles fixed elements better */
            }
            /* Hide scrollbar for Chrome, Safari and Opera */
            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }
            /* Hide scrollbar for IE, Edge and Firefox */
            .no-scrollbar {
                -ms-overflow-style: none; /* IE and Edge */
                scrollbar-width: none; /* Firefox */
            }
        </style>
    </head>
    <body
        class="bg-surface-50 text-surface-900 font-sans min-h-screen selection:bg-brand-100 selection:text-brand-900"
    >
        <!-- NAVIGATION -->
        <header
            class="sticky top-0 z-[100] bg-white/80 backdrop-blur-xl border-b border-surface-200/50 transition-all duration-300"
            id="main-header"
        >
            <div
                class="max-w-6xl mx-auto px-4 md:px-8 h-16 md:h-24 flex items-center justify-between transition-all duration-300"
                id="header-container"
            >
                <a
                    href={`${base}`}
                    class="flex items-center gap-2 md:gap-3 group relative z-[210]"
                >
                    <div
                        class="w-9 h-9 md:w-11 md:h-11 bg-gradient-to-br from-brand-500 to-brand-700 rounded-xl flex items-center justify-center text-white font-bold text-lg md:text-xl shadow-xl shadow-brand-500/20 group-hover:rotate-6 transition-all duration-300"
                    >
                        M
                    </div>
                    <div class="flex flex-col">
                        <span
                            class="font-black text-lg md:text-2xl tracking-tighter text-surface-950 leading-none"
                        >
                            Manual<span class="text-brand-600">do</span>Técnico
                        </span>
                        <span
                            class="text-[8px] md:text-[9px] font-bold uppercase tracking-[0.2em] text-surface-400 mt-0.5 md:mt-1"
                            >Knowledge Hub</span
                        >
                    </div>
                </a>

                <!-- DESKTOP NAV -->
                <nav
                    class="hidden md:flex items-center gap-1 bg-surface-100/50 p-1.5 rounded-2xl border border-surface-200/50"
                >
                    <a
                        href={`${base}conteudos`}
                        class="px-5 py-2 rounded-xl font-bold text-[10px] uppercase tracking-widest text-surface-500 hover:text-brand-600 hover:bg-white hover:shadow-sm transition-all"
                        >Conteúdos</a
                    >
                    <a
                        href={`${base}noticias`}
                        class="px-5 py-2 rounded-xl font-bold text-[10px] uppercase tracking-widest text-surface-500 hover:text-brand-600 hover:bg-white hover:shadow-sm transition-all"
                        >Notícias</a
                    >
                    <a
                        href={`${base}ferramentas`}
                        class="px-5 py-2 rounded-xl font-bold text-[10px] uppercase tracking-widest text-surface-500 hover:text-brand-600 hover:bg-white hover:shadow-sm transition-all"
                        >Ferramentas</a
                    >
                </nav>

                <!-- MOBILE TRIGGER -->
                <div class="flex items-center md:hidden relative z-[210]">
                    <button
                        id="mobile-menu-toggle"
                        class="p-2 bg-surface-100 text-surface-950 rounded-xl active:scale-95 transition-all shadow-sm"
                        aria-label="Toggle Menu"
                    >
                        <svg
                            id="menu-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.5"
                                d="M4 8h16M4 16h16"></path>
                        </svg>
                        <svg
                            id="close-icon"
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 hidden"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2.5"
                                d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- MOBILE NAV OVERLAY (MOVED OUTSIDE HEADER) -->
        <div
            id="mobile-menu"
            class="fixed inset-0 bg-white z-[999] translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.4,0,0.2,1)] md:hidden flex flex-col pt-32 px-8 overflow-y-auto"
        >
            <div class="flex flex-col gap-4">
                <span
                    class="text-[10px] font-black text-brand-600 uppercase tracking-widest opacity-50 ml-2"
                    >Navegação Principal</span
                >
                <nav class="flex flex-col">
                    <a
                        href={`${base}conteudos`}
                        class="text-5xl font-black text-surface-950 p-3 hover:text-brand-600 transition-colors uppercase tracking-tighter"
                        >Conteúdos</a
                    >
                    <a
                        href={`${base}noticias`}
                        class="text-5xl font-black text-surface-950 p-3 hover:text-brand-600 transition-colors uppercase tracking-tighter"
                        >Notícias</a
                    >
                    <a
                        href={`${base}ferramentas`}
                        class="text-5xl font-black text-surface-950 p-3 hover:text-brand-600 transition-colors uppercase tracking-tighter"
                        >Ferramentas</a
                    >
                </nav>
            </div>

            <div class="mt-auto mb-16">
                <div
                    class="p-8 bg-surface-50 rounded-3xl border border-surface-100"
                >
                    <p
                        class="text-[10px] font-black text-brand-600 uppercase tracking-widest opacity-50 ml-2"
                    >
                        Manual do Técnico
                    </p>
                    <p
                        class="text-sm font-medium text-surface-600 leading-relaxed italic"
                    >
                        "Documentação de alta performance para técnicos de
                        elite."
                    </p>
                </div>
            </div>
        </div>

        <!-- BACK TO TOP BUTTON -->
        <button
            id="back-to-top"
            class="fixed bottom-8 right-8 z-[150] w-12 h-12 bg-white/80 backdrop-blur-lg border border-surface-200 text-surface-950 rounded-full shadow-2xl shadow-brand-500/10 flex items-center justify-center opacity-0 translate-y-10 pointer-events-none transition-all duration-500 hover:bg-brand-600 hover:text-white hover:border-brand-600 active:scale-90 group"
            aria-label="Voltar ao topo"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5 group-hover:-translate-y-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 15l7-7 7 7"></path>
            </svg>
        </button>

        <script>
            const toggle = document.getElementById("mobile-menu-toggle");
            const menu = document.getElementById("mobile-menu");
            const menuIcon = document.getElementById("menu-icon");
            const closeIcon = document.getElementById("close-icon");
            const backToTop = document.getElementById("back-to-top");

            let isOpen = false;

            toggle?.addEventListener("click", () => {
                isOpen = !isOpen;
                if (isOpen) {
                    menu?.classList.remove("translate-x-full");
                    menuIcon?.classList.add("hidden");
                    closeIcon?.classList.remove("hidden");
                    document.body.style.overflow = "hidden";
                } else {
                    menu?.classList.add("translate-x-full");
                    menuIcon?.classList.remove("hidden");
                    closeIcon?.classList.add("hidden");
                    document.body.style.overflow = "";
                }
            });

            // Back to Top Logic
            backToTop?.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });

            // Scroll Events
            window.addEventListener("scroll", () => {
                const headerContainer =
                    document.getElementById("header-container");
                const scrollY = window.scrollY;

                // Header shrink
                if (scrollY > 20) {
                    headerContainer?.classList.replace("md:h-24", "md:h-16");
                    headerContainer?.parentElement?.classList.replace(
                        "bg-white/80",
                        "bg-white/95",
                    );
                } else {
                    headerContainer?.classList.replace("md:h-16", "md:h-24");
                    headerContainer?.parentElement?.classList.replace(
                        "bg-white/95",
                        "bg-white/80",
                    );
                }

                // Back to Top visibility
                if (scrollY > 400) {
                    backToTop?.classList.remove(
                        "opacity-0",
                        "translate-y-10",
                        "pointer-events-none",
                    );
                } else {
                    backToTop?.classList.add(
                        "opacity-0",
                        "translate-y-10",
                        "pointer-events-none",
                    );
                }
            });
        </script>

        <!-- MAIN -->
        <main class="flex-grow pt-24 md:pt-32">
            <slot />
        </main>

        <CookieConsent client:load base={base} />

        <!-- FOOTER -->
        <footer
            class="bg-surface-950 text-white py-20 border-t border-surface-800"
        >
            <div
                class="max-w-6xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-12 gap-16"
            >
                <div class="md:col-span-5 space-y-6">
                    <div class="flex items-center gap-3">
                        <div
                            class="w-8 h-8 bg-brand-500 rounded-lg flex items-center justify-center text-white font-bold text-lg"
                        >
                            M
                        </div>
                        <span class="font-bold text-xl tracking-tight"
                            >Manual<span class="text-brand-500">do</span
                            >Técnico</span
                        >
                    </div>
                    <p
                        class="text-surface-400 text-lg leading-relaxed max-w-sm"
                    >
                        O hub definitivo de conhecimento para técnicos de TI,
                        unindo documentação precisa e feed de notícias em tempo
                        real.
                    </p>
                </div>

                <div class="md:col-span-3">
                    <h4
                        class="font-bold text-xs uppercase tracking-[0.2em] text-surface-500 mb-8"
                    >
                        Navegação
                    </h4>
                    <ul class="space-y-4 text-sm font-medium">
                        <li>
                            <a
                                href={`${base}conteudos`}
                                class="text-surface-300 hover:text-brand-500 transition-colors"
                                >Conteúdos</a
                            >
                        </li>
                        <li>
                            <a
                                href={`${base}noticias`}
                                class="text-surface-300 hover:text-brand-500 transition-colors"
                                >Notícias</a
                            >
                        </li>
                    </ul>
                </div>

                <div class="md:col-span-4">
                    <h4
                        class="font-bold text-xs uppercase tracking-[0.2em] text-surface-500 mb-8"
                    >
                        Comunidade
                    </h4>
                    <p class="text-sm text-surface-400 leading-relaxed mb-6">
                        Contribua com a nossa base de conhecimento ou sugira
                        novas ferramentas.
                    </p>
                    <a
                        href="#"
                        class="inline-flex h-12 px-6 items-center justify-center rounded-xl bg-surface-800 text-xs font-bold uppercase tracking-widest hover:bg-surface-700 transition-all border border-surface-700"
                        >Contribuir agora</a
                    >
                </div>
            </div>

            <div
                class="max-w-6xl mx-auto px-4 md:px-8 mt-20 pt-8 border-t border-surface-800/50 flex flex-col md:flex-row justify-between items-center gap-6"
            >
                <p class="text-xs text-surface-500">
                    &copy; {new Date().getFullYear()} Manual do Técnico. Todos os
                    direitos reservados.
                </p>
                <div
                    class="flex gap-8 text-[10px] font-bold uppercase tracking-widest text-surface-500"
                >
                    <a href={`${base}privacidade`} class="hover:text-white transition-colors"
                        >Privacidade</a
                    >
                    <a href={`${base}termos`} class="hover:text-white transition-colors"
                        >Termos de Uso</a
                    >
                </div>
            </div>
        </footer>
    </body>
</html>

